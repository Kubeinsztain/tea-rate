{
  "name": "tea-rate",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "check": "biome check .",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "prepare": "lefthook install",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:studio": "turbo run db:studio",
    "db:seed": "turbo run db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "lefthook": "^2.2.2",
    "turbo": "2.11.8",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ]
}

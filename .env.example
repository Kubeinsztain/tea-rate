# PostgreSQL connection string.
# Local development via podman: podman compose up -d
# (see compose-db-local.yml for the matching credentials)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tea_rate

# Base URL of the internal auth service. Used by the web app's `/api/auth/*`
# proxy and its server-side session reads to forward requests to the auth
# service. Must match the port the auth service listens on.
AUTH_SERVICE_URL=http://localhost:4000

# Node environment. Validated by @repo/env; defaults to "development".
NODE_ENV=development

# Set to "true" to skip startup env validation (e.g. during Docker builds).
# SKIP_ENV_VALIDATION=true

# ---------------------------------------------------------------------------
# Auth service (apps/auth)
#
# The auth service is a separate deployable with its OWN database on the same
# Postgres instance. Its `DATABASE_URL` (and remaining auth env) lives in
# `apps/auth/.env` — copy `apps/auth/.env.example` to set it up. Do NOT point
# the auth service at the journal `DATABASE_URL` above.
#
# BETTER_AUTH_SECRET=<see apps/auth/.env.example — openssl rand -base64 32>
# BETTER_AUTH_URL=http://localhost:4000
# SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASS/SMTP_FROM — validated fail-fast;
# stubbed until real email delivery is wired in.
# ---------------------------------------------------------------------------

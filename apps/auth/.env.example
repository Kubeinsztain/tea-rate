# Auth service environment. Copy to `.env` before running `just dev`.
# This service owns its own database on the shared Postgres instance —
# it must NOT point at the journal app's `DATABASE_URL`.

# PostgreSQL connection string for the auth service's own database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tea_rate_auth

# Secret used to sign JWT session tokens (>= 32 characters). Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-32-character-minimum-secret

# Internal base URL of the auth service. Better Auth uses it for its own
# routing and origin checks; user-facing email links are built from WEB_ORIGIN.
BETTER_AUTH_URL=http://localhost:4000

# Public origin of the web app that proxies `/api/auth/*` to this service.
# User-facing email links (reset, verify) are built against this origin, and it
# is trusted so Better Auth accepts the browser's forwarded `Origin` during
# sign-in.
WEB_ORIGIN=http://localhost:3000

# SMTP delivery settings for verification and password-reset email.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=auth
SMTP_PASS=password
SMTP_FROM=no-reply@example.com

# Port the auth service listens on.
PORT=4000

# Node environment. Validated by @repo/env; defaults to "development".
NODE_ENV=development
